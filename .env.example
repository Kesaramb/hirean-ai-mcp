# HireAn AI MCP configuration. Set these in your MCP client's environment.
# This example file is not loaded automatically.
# Legacy CAPCUT_* equivalents remain supported; non-empty HIREAN_AI_* values win.

# Base URL of the VectCutAPI backend (python capcut_server.py)
HIREAN_AI_API_URL=http://localhost:9001

# Request timeout in seconds. save_draft downloads every remote media file
# referenced by the timeline, so keep this generous.
HIREAN_AI_TIMEOUT=300

# Your CapCut drafts folder. Used as the default draft_folder for tools that
# take one, so you don't have to repeat it on every call.
#   macOS:   ~/Movies/CapCut/User Data/Projects/com.lveditor.draft
#   Windows: C:\Users\<you>\AppData\Local\CapCut\User Data\Projects\com.lveditor.draft
# HIREAN_AI_DRAFT_FOLDER=
